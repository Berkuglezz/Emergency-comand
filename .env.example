# =============================================================================
# Emergency Command — variables de entorno (PROTOTIPO DE DEMOSTRACIÓN)
#
# Copia este fichero a `.env` y sustituye los valores marcados con "change-me".
# Ningún valor de este fichero es válido para un despliegue real.
# `.env` está en .gitignore: nunca lo subas al repositorio.
# =============================================================================

# Entorno de ejecución: development | test | production.
# Las credenciales de demo y /docs solo están activos en `development`.
ENVIRONMENT=development

# Nivel de log del backend: DEBUG | INFO | WARNING | ERROR.
# Los logs nunca incluyen contraseñas, tokens ni cookies.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Puertos publicados en el host (solo Docker Compose)
# -----------------------------------------------------------------------------
# 5433 por defecto para no chocar con un PostgreSQL local en 5432.
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_USER=emergency
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=emergency_command
# Host y puerto desde los que el backend alcanza la base de datos.
# - Sin Docker (backend local + db en Docker): localhost y DB_HOST_PORT.
# - Con Docker Compose se sobrescriben a `db` y `5432` en docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# Autenticación
# -----------------------------------------------------------------------------
# Clave de firma de los JWT. Genera una propia, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
# Duración del access token (minutos) y del refresh token (días).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Atributo `Secure` de la cookie del refresh token.
# `false` solo en desarrollo sobre http; `true` en cualquier entorno con https.
REFRESH_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista JSON de orígenes permitidos. Nunca "*" (se usan credenciales).
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Datos de demostración (solo ENVIRONMENT=development)
# -----------------------------------------------------------------------------
# Contraseña de los tres usuarios demo que crea `python -m seeds.seed`
# (mínimo 12 caracteres). Si la cambias, el siguiente seed la actualiza.
DEMO_USER_PASSWORD=change-me-demo-password
